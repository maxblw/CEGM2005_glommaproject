    "def unity(data):\n",
    "    u_hat = data.copy()\n",
    "    for col in data.columns:\n",
    "        u_hat[col]= stats.rankdata(data[col]) / (len(data[col]) + 1)\n",
    "    return u_hat\n",
    "unity_df = unity(df.dropna())\n",
    "sns.pairplot(data=unity_df, height=2.5, plot_kws = dict(size=.1))"
   ]
